# Python. Unlike the prose-only skills in this org, these are real: setup.sh
# builds .venv inside skills/garmin/, which is exactly where SKILL.md expects it
# and exactly where it must never be committed.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Credentials live in ~/.garmin, never here. Listed anyway: a stray copy pulled
# into the repo while debugging is the one way a Garmin password reaches a
# public commit.
config.json
tokens/
