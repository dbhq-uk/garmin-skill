venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Settings and tokens live in ~/.dbhq/garmin, never here. Listed anyway: a
# stray copy pulled into the repo while debugging is how a token file, or a
# config.json from a version that still stored the password, reaches a public
# commit.
config.json
tokens/
